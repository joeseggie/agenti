# Docker Compose Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# PostgreSQL Configuration
POSTGRES_USER=agenti_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=agenti_dev

# JWT Configuration for Android API
# Generate a secure random key (minimum 32 characters):
#   openssl rand -base64 32
Jwt__Key=replace-with-a-secure-random-key-minimum-32-characters
Jwt__Issuer=EastSeat.Agenti
Jwt__Audience=EastSeat.Agenti.Android
Jwt__ExpiryMinutes=60
