<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- iOS-only for App Store deployment -->
		<TargetFrameworks>net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>EastSeat.Agenti.iOS</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name shown to users on device -->
		<ApplicationTitle>Agenti</ApplicationTitle>

		<!-- App Store bundle identifier - must match your App Store Connect app ID -->
		<ApplicationId>com.eastseat.agenti</ApplicationId>

		<!-- App version for App Store (increment for each release) -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!--
			Minimum iOS version: iOS 16.1
			Covers ~95%+ of active iOS devices as of 2024.
			Users on iOS 15.x and older will not be able to install the app.
		-->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.1</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1976D2" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1976D2" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (embedded configuration) -->
		<EmbeddedResource Include="Resources\Raw\appsettings.json">
			<LogicalName>appsettings.json</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\Raw\appsettings.Development.json" Condition="Exists('Resources\Raw\appsettings.Development.json')">
			<LogicalName>appsettings.Development.json</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Pages\ProfilePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>
