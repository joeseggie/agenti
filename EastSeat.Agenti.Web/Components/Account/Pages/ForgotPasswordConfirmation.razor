@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<div class="auth-page">
    <MudContainer MaxWidth="MaxWidth.Small" Class="auth-container">
        <MudCard Elevation="2" Class="auth-card">
            <MudCardContent>
                <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-3">Check your email</MudText>
                <MudText role="status">If your account is eligible, you will receive a link to reset your password.</MudText>
                <MudLink Href="/Account/Login" Class="mt-4 d-inline-block">Back to sign in</MudLink>
            </MudCardContent>
        </MudCard>
    </MudContainer>
</div>
