@inherits LayoutComponentBase
@using EastSeat.Agenti.Web.Features.Theme
@using EastSeat.Agenti.Web.Features.Notifications
@inject IThemeService ThemeService
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject ILogger<MainLayout> Logger
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudThemeProvider Theme="@_currentTheme" IsDarkMode="@_isDarkMode" ObserveSystemThemeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="skip-link" href="#main-content" @onclick="SkipToMainContentAsync" @onclick:preventDefault>Skip to main content</a>

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Default" Class="app-topbar">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                    OnClick="@ToggleDrawer" aria-label="Toggle navigation" />
            </Authorized>
        </AuthorizeView>
        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Secondary" Size="Size.Medium" />
        <MudStack Spacing="0" Class="ml-3">
            <MudText Typo="Typo.h6" Class="app-brand-title">Agenti</MudText>
            <MudText Typo="Typo.overline" Class="app-brand-subtitle">Branch operations</MudText>
        </MudStack>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudBadge Content="@_unreadCount" Visible="@(_unreadCount > 0)" Color="Color.Error" Overlap="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                        Color="@(_notificationRefreshFailed ? Color.Warning : Color.Inherit)"
                        OnClick="@(() => NavigationManager.NavigateTo("/notifications"))"
                        Title="@NotificationLabel" aria-label="@NotificationLabel" />
                </MudBadge>

                <form id="logout-form" action="Account/Logout" method="post" style="display:none">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="/" />
                </form>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" AriaLabel="User menu" Color="Color.Inherit"
                    AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ChildContent>
                        <MudMenuItem Disabled="true">
                            <MudText Typo="Typo.body2"><strong>@context.User.Identity?.Name</strong></MudText>
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                            OnClick="@ToggleTheme">
                            @GetThemeLabel()
                        </MudMenuItem>
                        <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.Person">
                            Profile
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@SubmitLogoutAsync">
                            Logout
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer"
                Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent Class="app-main-content pt-16 px-4">
        <main id="main-content" tabindex="-1" @ref="_mainContent">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error message">X</button>
</div>

@code {
    private bool _drawerOpen = true;
    private ElementReference _mainContent;
    private DotNetObjectReference<MainLayout>? _themeReference;
    private IJSObjectReference? _themeWatcher;
    private Task? _themeInitializationTask;
    private bool _isDarkMode = false;
    private MudTheme _currentTheme = AppThemes.LightTheme;
    private string _themePreference = ThemePreferenceConstants.System;
    private int _unreadCount;
    private bool _notificationRefreshFailed;
    private readonly CancellationTokenSource _notificationCts = new();
    private Task? _notificationTask;
    private bool _disposed;

    private string NotificationLabel => _notificationRefreshFailed
        ? "Notifications (unread count temporarily unavailable)"
        : _unreadCount == 0 ? "Notifications" : $"Notifications ({_unreadCount} unread)";

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await ThemeService.InitializeAsync(null);
        _themePreference = await ThemeService.GetUserPreferenceAsync();
        ThemeService.ThemeChanged += OnThemeChanged;
        _isDarkMode = ThemeService.IsDarkMode;
        _currentTheme = _isDarkMode ? AppThemes.DarkTheme : AppThemes.LightTheme;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _notificationTask = RefreshNotificationCountPeriodically(_notificationCts.Token);
        _themeInitializationTask = InitializeBrowserThemeAsync();
        await _themeInitializationTask;
    }

    private async Task InitializeBrowserThemeAsync()
    {
        try
        {
            var systemPreference = await JS.InvokeAsync<string>("themeHelpers.getSystemThemePreference");
            if (_disposed)
                return;

            ThemeService.UpdateSystemPreference(systemPreference);
            _themeReference = DotNetObjectReference.Create(this);
            _themeWatcher = await JS.InvokeAsync<IJSObjectReference>(
                "themeHelpers.watchSystemThemePreference", _themeReference);
        }
        catch (JSDisconnectedException)
        {
            Logger.LogDebug("The circuit disconnected before system theme detection completed.");
        }
        catch (JSException exception)
        {
            Logger.LogWarning("System theme detection failed with {ExceptionType}.", exception.GetType().Name);
            Snackbar.Add("System theme detection is unavailable. You can still choose a theme from the user menu.", Severity.Warning);
        }
    }

    private async Task RefreshNotificationCountPeriodically(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            await RefreshUnreadCountAsync();
            while (await timer.WaitForNextTickAsync(token))
                await RefreshUnreadCountAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is not null)
            {
                var unreadCount = await NotificationService.GetUnreadCountAsync(userId);
                if (!_disposed && (unreadCount != _unreadCount || _notificationRefreshFailed))
                {
                    _unreadCount = unreadCount;
                    _notificationRefreshFailed = false;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception exception)
        {
            if (_disposed)
                return;

            Logger.LogWarning("Notification refresh failed with {ExceptionType}.", exception.GetType().Name);
            if (!_notificationRefreshFailed)
            {
                _notificationRefreshFailed = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task SubmitLogoutAsync()
    {
        await JS.InvokeVoidAsync("submitForm", "logout-form");
    }

    private async Task SkipToMainContentAsync() => await _mainContent.FocusAsync();

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Close the drawer on navigation when in responsive overlay mode (mobile)
        _drawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        var currentPref = await ThemeService.GetUserPreferenceAsync();
        var newPref = currentPref switch
        {
            ThemePreferenceConstants.Light => ThemePreferenceConstants.Dark,
            ThemePreferenceConstants.Dark => ThemePreferenceConstants.System,
            _ => ThemePreferenceConstants.Light
        };
        if (await ThemeService.SetUserPreferenceAsync(newPref))
            _themePreference = newPref;
        else
            Snackbar.Add("Your theme preference could not be saved. Please try again.", Severity.Error);
    }

    private void OnThemeChanged(object? sender, EventArgs e)
    {
        _isDarkMode = ThemeService.IsDarkMode;
        _currentTheme = _isDarkMode ? AppThemes.DarkTheme : AppThemes.LightTheme;
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnSystemThemeChanged(string systemPreference) => InvokeAsync(() =>
    {
        if (!_disposed)
            ThemeService.UpdateSystemPreference(systemPreference);
    });

    private string GetThemeLabel() => _themePreference switch
    {
        ThemePreferenceConstants.Light => "Use dark theme",
        ThemePreferenceConstants.Dark => "Use system theme",
        _ => "Use light theme"
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
        ThemeService.ThemeChanged -= OnThemeChanged;
        await _notificationCts.CancelAsync();
        if (_themeInitializationTask is not null)
            await _themeInitializationTask;
        if (_themeWatcher is not null)
        {
            try
            {
                await _themeWatcher.InvokeVoidAsync("dispose");
                await _themeWatcher.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                Logger.LogDebug("The circuit disconnected before theme observer cleanup.");
            }
        }
        _themeReference?.Dispose();
        if (_notificationTask is not null)
            await _notificationTask;
        _notificationCts.Dispose();
    }
}