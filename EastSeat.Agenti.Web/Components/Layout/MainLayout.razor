@inherits LayoutComponentBase
@using EastSeat.Agenti.Web.Features.Theme
@using EastSeat.Agenti.Web.Features.Notifications
@inject IThemeService ThemeService
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" Theme="@_currentTheme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
            OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">Agenti ERP</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudBadge Content="@_unreadCount" Visible="@(_unreadCount > 0)" Color="Color.Error" Overlap="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                        Color="Color.Inherit"
                        OnClick="@(() => NavigationManager.NavigateTo("/notifications"))"
                        Title="Notifications" />
                </MudBadge>

                <form id="logout-form" action="Account/Logout" method="post" style="display:none">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="/" />
                </form>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudIconButton Color="Color.Inherit">
                            <MudAvatar Size="Size.Small" Color="Color.Secondary">
                                @GetInitials(context.User.Identity?.Name)
                            </MudAvatar>
                        </MudIconButton>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Disabled="true">
                            <MudText Typo="Typo.body2"><strong>@context.User.Identity?.Name</strong></MudText>
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                            OnClick="@ToggleTheme">
                            @GetThemeLabel()
                        </MudMenuItem>
                        <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.Person">
                            Profile
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@SubmitLogoutAsync">
                            Logout
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2"
        Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pt-16 px-4">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private MudThemeProvider? _themeProvider;
    private bool _isDarkMode = false;
    private MudTheme _currentTheme = AppThemes.LightTheme;
    private DotNetObjectReference<MainLayout>? _dotNetHelper;
    private int _unreadCount;
    private CancellationTokenSource? _notificationCts;

    protected override async Task OnInitializedAsync()
    {
        // Auto-close drawer on navigation (for mobile overlay mode)
        NavigationManager.LocationChanged += OnLocationChanged;

        // Detect system theme
        string? systemPreference = null;
        try
        {
            systemPreference = await JS.InvokeAsync<string>("themeHelpers.getSystemThemePreference");
        }
        catch
        {
            systemPreference = "light";
        }

        // Initialize theme service
        await ThemeService.InitializeAsync(systemPreference);
        ThemeService.ThemeChanged += OnThemeChanged;

        // Set initial theme
        _isDarkMode = ThemeService.IsDarkMode;
        _currentTheme = _isDarkMode ? AppThemes.DarkTheme : AppThemes.LightTheme;

        // Watch system theme changes
        try
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("themeHelpers.watchSystemThemePreference", _dotNetHelper);
        }
        catch
        {
            // If JS interop fails, continue without system theme watching
        }

        // Start periodic notification count refresh
        _ = RefreshNotificationCountPeriodically();
    }

    private async Task RefreshNotificationCountPeriodically()
    {
        _notificationCts = new CancellationTokenSource();
        var token = _notificationCts.Token;

        // Initial load
        await RefreshUnreadCountAsync();

        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await RefreshUnreadCountAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on dispose
        }
    }

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is not null)
            {
                _unreadCount = await NotificationService.GetUnreadCountAsync(userId);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // Silently ignore polling errors
        }
    }

    private async Task SubmitLogoutAsync()
    {
        await JS.InvokeVoidAsync("submitForm", "logout-form");
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Close the drawer on navigation when in responsive overlay mode (mobile)
        _drawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        var currentPref = await ThemeService.GetUserPreferenceAsync();
        var newPref = currentPref switch
        {
            ThemePreferenceConstants.Light => ThemePreferenceConstants.Dark,
            ThemePreferenceConstants.Dark => ThemePreferenceConstants.System,
            _ => ThemePreferenceConstants.Light
        };
        await ThemeService.SetUserPreferenceAsync(newPref);
    }

    private void OnThemeChanged(object? sender, EventArgs e)
    {
        _isDarkMode = ThemeService.IsDarkMode;
        _currentTheme = _isDarkMode ? AppThemes.DarkTheme : AppThemes.LightTheme;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSystemThemeChanged(string newTheme)
    {
        var userPref = await ThemeService.GetUserPreferenceAsync();
        if (userPref == ThemePreferenceConstants.System)
        {
            await ThemeService.InitializeAsync(newTheme);
        }
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : name[..1].ToUpperInvariant();
    }

    private string GetThemeLabel() => _isDarkMode ? "Light Mode" : "Dark Mode";

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        ThemeService.ThemeChanged -= OnThemeChanged;
        _notificationCts?.Cancel();
        _notificationCts?.Dispose();
        _dotNetHelper?.Dispose();
    }
}