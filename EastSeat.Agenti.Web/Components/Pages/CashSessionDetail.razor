@page "/cashsessions/{Id:long}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using EastSeat.Agenti.Web.Features.CashSessions
@using EastSeat.Agenti.Web.Features.CashCounts
@using EastSeat.Agenti.Shared.Domain.Enums
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICashSessionService CashSessionService
@inject ICashCountService CashCountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Cash Session Details - Agenti</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (_isLoading)
    {
        <MudGrid>
            <MudItem xs="12" Class="d-flex justify-center">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    }
    else if (_session == null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            Cash session not found.
        </MudAlert>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-4" StartIcon="@Icons.Material.Filled.ArrowBack"
            OnClick="GoBack">
            Back to Sessions
        </MudButton>
    }
    else
    {
        <!-- Header -->
        <MudGrid>
            <MudItem xs="12" sm="8">
                <MudButton Variant="Variant.Text" Color="Color.Default" Class="mb-2"
                    StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">
                    Back to Sessions
                </MudButton>
                <MudText Typo="Typo.h4" Class="mb-2">
                    @_session.SessionDate.ToString("dddd, MMMM dd, yyyy")
                </MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_session.Status)">
                        @GetStatusText(_session.Status)
                    </MudChip>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @_session.AgentSummaries.Count agent(s)
                    </MudText>
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadSessionAsync"
                    StartIcon="@Icons.Material.Filled.Refresh" Disabled="_isLoading">
                    Refresh
                </MudButton>
            </MudItem>
        </MudGrid>

        <!-- Session Summary -->
        <MudCard Elevation="2" Class="mt-4">
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Opened At</MudText>
                        <MudText Typo="Typo.body1">@_session.OpenedAt.ToLocalTime().ToString("HH:mm")</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Closed At</MudText>
                        @if (_session.ClosedAt.HasValue)
                        {
                            <MudText Typo="Typo.body1">@_session.ClosedAt.Value.ToLocalTime().ToString("HH:mm")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1" Style="opacity: 0.5;">---</MudText>
                        }
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Opening</MudText>
                        <MudText Typo="Typo.body1">UGX @_session.TotalOpeningAmount.ToString("N0")</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Closing</MudText>
                        @if (_session.TotalClosingAmount.HasValue)
                        {
                            <MudText Typo="Typo.body1">UGX @_session.TotalClosingAmount.Value.ToString("N0")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1" Style="opacity: 0.5;">---</MudText>
                        }
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <!-- Agent Participation Cards -->
        @foreach (var agent in _session.AgentSummaries)
        {
            <MudCard Elevation="2" Class="mt-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">@agent.AgentName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">(@agent.AgentCode)</MudText>
                            @if (agent.HasDiscrepancy)
                            {
                                @if (agent.Variance.HasValue && agent.Variance.Value > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">Surplus</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Shortage</MudChip>
                                }
                            }
                        </MudStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                @if (_session.Status != CashSessionStatus.Closed &&
                                     agent.OpeningCount?.Status == CashCountStatus.Approved &&
                                     agent.ClosingCount?.Status != CashCountStatus.Approved)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                                        OnClick="@(() => AdminCloseForAgent(agent.AgentId))">
                                        Close for Agent
                                    </MudButton>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <!-- Opening Count -->
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Class="mb-1">Opening Count</MudText>
                            @if (agent.OpeningCount != null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@GetCountStatusColor(agent.OpeningCount.Status)">
                                    @GetCountStatusText(agent.OpeningCount.Status)
                                </MudChip>
                                <MudText Typo="Typo.body1" Class="mt-1">UGX @agent.OpeningCount.TotalAmount.ToString("N0")</MudText>
                                @if (agent.OpeningCount.WalletEntries.Count > 0)
                                {
                                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-1">
                                        <thead>
                                            <tr>
                                                <th>Wallet</th>
                                                <th style="text-align: right;">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var w in agent.OpeningCount.WalletEntries)
                                            {
                                                <tr>
                                                    <td>@w.WalletName</td>
                                                    <td style="text-align: right;">@w.Amount.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="opacity: 0.5;">Not recorded</MudText>
                            }
                        </MudItem>

                        <!-- Closing Count -->
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Class="mb-1">Closing Count</MudText>
                            @if (agent.ClosingCount != null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@GetCountStatusColor(agent.ClosingCount.Status)">
                                    @GetCountStatusText(agent.ClosingCount.Status)
                                </MudChip>
                                <MudText Typo="Typo.body1" Class="mt-1">UGX @agent.ClosingCount.TotalAmount.ToString("N0")</MudText>
                                @if (agent.Variance.HasValue && agent.Variance.Value != 0)
                                {
                                    <MudText Typo="Typo.body2" Color="@(agent.Variance.Value > 0 ? Color.Info : Color.Warning)" Class="mt-1">
                                        @(agent.Variance.Value > 0 ? "Surplus" : "Shortage"): UGX @(agent.Variance.Value > 0 ? "+" : "")@agent.Variance.Value.ToString("N0")
                                    </MudText>
                                }
                                @if (!string.IsNullOrEmpty(agent.ClosingCount.Explanation))
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-1">
                                        @agent.ClosingCount.Explanation
                                    </MudAlert>
                                }
                                @if (!string.IsNullOrEmpty(agent.ClosingCount.RejectionReason))
                                {
                                    <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="mt-1">
                                        Rejected: @agent.ClosingCount.RejectionReason
                                    </MudAlert>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="opacity: 0.5;">Not recorded</MudText>
                            }
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        }
    }
</MudContainer>

@code {
    [Parameter]
    public long Id { get; set; }

    private CashSessionDetailDto? _session;
    private bool _isLoading = true;
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadSessionAsync();
    }

    private async Task LoadSessionAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _session = await CashSessionService.GetCashSessionDetailAsync(Id);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/cashsessions");
    }

    private async Task AdminCloseForAgent(long agentId)
    {
        if (string.IsNullOrEmpty(_userId)) return;

        var result = await CashCountService.AdminCloseAgentSessionAsync(_userId, Id, agentId);
        if (result.Success)
        {
            Snackbar.Add("Agent's session closed by admin.", Severity.Success);
            await LoadSessionAsync();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to close agent session.", Severity.Error);
        }
    }

    private static Color GetStatusColor(CashSessionStatus status) => status switch
    {
        CashSessionStatus.Open => Color.Success,
        CashSessionStatus.Completed => Color.Info,
        CashSessionStatus.Pending => Color.Warning,
        CashSessionStatus.DiscrepancyUnderReview => Color.Warning,
        CashSessionStatus.Blocked => Color.Error,
        CashSessionStatus.Closed => Color.Default
    };

    private static string GetStatusText(CashSessionStatus status) => status switch
    {
        CashSessionStatus.Open => "Open",
        CashSessionStatus.Completed => "Completed",
        CashSessionStatus.Pending => "Pending",
        CashSessionStatus.DiscrepancyUnderReview => "Under Review",
        CashSessionStatus.Blocked => "Blocked",
        CashSessionStatus.Closed => "Closed"
    };

    private static Color GetCountStatusColor(CashCountStatus status) => status switch
    {
        CashCountStatus.Draft => Color.Default,
        CashCountStatus.PendingApproval => Color.Warning,
        CashCountStatus.Approved => Color.Success,
        CashCountStatus.Rejected => Color.Error
    };

    private static string GetCountStatusText(CashCountStatus status) => status switch
    {
        CashCountStatus.Draft => "Draft",
        CashCountStatus.PendingApproval => "Pending Approval",
        CashCountStatus.Approved => "Approved",
        CashCountStatus.Rejected => "Rejected"
    };
}
