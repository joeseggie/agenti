@page "/notifications"
@using Microsoft.AspNetCore.Authorization
@using EastSeat.Agenti.Web.Features.Notifications
@using EastSeat.Agenti.Shared.Domain.Enums
@using EastSeat.Agenti.Shared.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject ILogger<Notifications> Logger

<PageTitle>Notifications - Agenti</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4" HtmlTag="h1">Notifications</MudText>
            <MudText Typo="Typo.body2">Messages and task reminders. Marking a message as read does not approve a financial request.</MudText>
        </div>
        <MudStack Row="true" Wrap="Wrap.Wrap">
            <MudButton OnClick="RefreshAsync" Disabled="@(_loading || _actioning)" Variant="Variant.Outlined">Refresh</MudButton>
            <MudButton OnClick="MarkAllAsReadAsync" Disabled="@(_loading || _actioning || _unreadCount == 0)"
                StartIcon="@Icons.Material.Filled.DoneAll">Mark all as read</MudButton>
        </MudStack>
    </MudStack>
    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="8">
            <MudTextField T="string" Label="Search notifications" @bind-Value="_search" @bind-Value:after="ApplyFiltersAsync"
                Immediate="true" DebounceInterval="300" Clearable="true" Disabled="_actioning"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="string" Label="Read status" @bind-Value="_readStatus" @bind-Value:after="ApplyFiltersAsync" Disabled="_actioning">
                <MudSelectItem Value="@("All")">All</MudSelectItem>
                <MudSelectItem Value="@("Unread")">Unread</MudSelectItem>
                <MudSelectItem Value="@("Read")">Read</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="my-3">@_error</MudAlert>
    }
    @if (_userId != null)
    {
        <MudTable T="NotificationListItemDto" @ref="_table" ServerData="LoadPageAsync" RowsPerPage="10"
            Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="mt-4" Loading="_loading" data-testid="notification-history">
            <HeaderContent>
                <MudTh>Date (Uganda)</MudTh><MudTh>Sender</MudTh><MudTh>Message</MudTh>
                <MudTh>Priority</MudTh><MudTh>Status</MudTh><MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date (Uganda)">@BusinessTimeText.Format(context.CreatedAt)</MudTd>
                <MudTd DataLabel="Sender">@context.SenderName</MudTd>
                <MudTd DataLabel="Message">
                    @if (!string.IsNullOrWhiteSpace(context.Title))
                    {
                        <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                    }
                    <MudText Typo="Typo.body2">@context.Message</MudText>
                </MudTd>
                <MudTd DataLabel="Priority"><MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(context.Priority)">@context.Priority</MudChip></MudTd>
                <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@(context.IsRead ? Color.Default : Color.Info)">@(context.IsRead ? "Read" : "Unread")</MudChip></MudTd>
                <MudTd DataLabel="Actions">
                    @if (context.TransactionId.HasValue)
                    {
                        <AuthorizeView Policy="VaultApprove" Context="vaultReview">
                            <MudButton Href="/vault" Size="Size.Small" Color="Color.Primary">Review vault request</MudButton>
                        </AuthorizeView>
                    }
                    @if (!context.IsRead)
                    {
                        <MudButton OnClick="@(() => MarkAsReadAsync(context.Id))" Size="Size.Small" Disabled="@(_loading || _actioning)">Mark as read</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">@(_error != null ? "Notifications are unavailable. Select Refresh to retry." :
                    _readStatus != "All" || !string.IsNullOrWhiteSpace(_search) ? "No notifications match these filters. Clear the search or choose All." :
                    "No notifications yet. Messages and task reminders will appear here.")</MudText>
            </NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="@PageSizes" /></PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private MudTable<NotificationListItemDto>? _table;
    private string? _userId;
    private string? _search;
    private string _readStatus = "All";
    private string? _error;
    private bool _loading;
    private bool _actioning;
    private int _unreadCount;
    private static readonly int[] PageSizes = [10, 25, 50];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (_userId == null) _error = "Your sign-in could not be verified. Sign in again to view notifications.";
    }

    private async Task<TableData<NotificationListItemDto>> LoadPageAsync(TableState state, CancellationToken token)
    {
        _loading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await NotificationService.GetNotificationsPageAsync(_userId!, new(state.Page, state.PageSize),
                _readStatus == "All" ? null : _readStatus == "Read", _search, token);
            _unreadCount = await NotificationService.GetUnreadCountAsync(_userId!);
            token.ThrowIfCancellationRequested();
            return new() { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
        catch (Exception exception)
        {
            Logger.LogError("Notification history failed with {ExceptionType}.", exception.GetType().Name);
            _error = "Notifications could not be loaded. Select Refresh to retry.";
            return new() { Items = [], TotalItems = 0 };
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyFiltersAsync()
    {
        if (_table == null) return;
        if (_table.CurrentPage == 0) await _table.ReloadServerData();
        else _table.NavigateTo(0);
    }

    private Task RefreshAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;
    private Task MarkAsReadAsync(Guid id) => UpdateReadStateAsync(() => NotificationService.MarkAsReadAsync(id, _userId!));
    private Task MarkAllAsReadAsync() => UpdateReadStateAsync(() => NotificationService.MarkAllAsReadAsync(_userId!));

    private async Task UpdateReadStateAsync(Func<Task<NotificationSaveResult>> action)
    {
        if (_userId == null || _actioning || _loading) return;
        _actioning = true;
        _error = null;
        try
        {
            var result = await action();
            if (!result.Success)
                _error = result.ErrorMessage ?? "The read status could not be updated.";
            else
            {
                Snackbar.Add("Read status updated.", Severity.Success);
                await ApplyFiltersAsync();
            }
        }
        catch (Exception exception)
        {
            Logger.LogError("Notification update failed with {ExceptionType}.", exception.GetType().Name);
            _error = "The update could not be confirmed. Refresh the list before trying again.";
        }
        finally { _actioning = false; }
    }

    private static Color GetPriorityColor(NotificationPriority priority) => priority switch
    {
        NotificationPriority.High => Color.Warning,
        NotificationPriority.Urgent => Color.Error,
        NotificationPriority.Normal => Color.Info,
        _ => Color.Default
    };
}
