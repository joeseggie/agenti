@page "/vault"
@using Microsoft.AspNetCore.Authorization
@using EastSeat.Agenti.Web.Features.Vaults
@using EastSeat.Agenti.Shared.Domain.Enums
@using EastSeat.Agenti.Shared.Services
@attribute [Authorize(Policy = "VaultView")]
@rendermode InteractiveServer
@inject IVaultService VaultService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ILogger<Vault> Logger

<PageTitle>Vault - Agenti</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4" HtmlTag="h1">Vault Management</MudText>
        <MudButton OnClick="LoadVaultAsync" Disabled="@(_isLoading || _historyLoading || _actioning)" Variant="Variant.Outlined">Refresh</MudButton>
    </MudStack>
    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="my-3">@_error</MudAlert>
    }

    @if (_isLoading)
    {
        <MudGrid Class="mt-4">
            <MudItem xs="12" Class="d-flex justify-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </MudItem>
        </MudGrid>
    }
    else if (_vault != null)
    {
        <!-- Vault Balance Card -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Color="Color.Default">Current Vault Balance</MudText>
                        <MudText Typo="Typo.h3" HtmlTag="p" Color="Color.Primary">
                            UGX @(_vault.CurrentBalance.ToString("N0"))
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mt-2">@_vault.BranchName</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Actions -->
        <MudGrid Class="mb-4">
            <MudItem xs="12">
                <AuthorizeView Policy="VaultApprove">
                    <Authorized Context="auth">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NavigateToAdjustment"
                            EndIcon="@Icons.Material.Filled.AddCircle">
                            Request Manual Adjustment
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </MudItem>
        </MudGrid>

        <!-- Pending Approvals Section (Admin only) -->
        <AuthorizeView Policy="VaultApprove">
            <Authorized Context="auth">
                @if (_pendingTransactions.Any())
                {
                    <MudCard Class="mb-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" HtmlTag="h2">Pending Approvals (@_pendingTransactions.Count)</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.body2" Class="mb-3">Review the creator, amount, notes and expiry before deciding. History filters do not hide pending requests.</MudText>
                            <MudTable Items="@_pendingTransactions" Hover="true" Striped="true" RowsPerPage="10"
                                Breakpoint="Breakpoint.Sm" data-testid="vault-pending">
                                <HeaderContent>
                                    <MudTh>Created By</MudTh>
                                    <MudTh>Type</MudTh>
                                    <MudTh>Amount</MudTh>
                                    <MudTh>Notes</MudTh>
                                    <MudTh>Expires In</MudTh>
                                    <MudTh>Actions</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="trx">
                                    <MudTd DataLabel="Created By">@trx.CreatedBy</MudTd>
                                    <MudTd DataLabel="Type">
                                        <MudChip T="string" Color="@GetTransactionTypeColor(trx.Type)"
                                            Icon="@GetTransactionTypeIcon(trx.Type)" Size="Size.Small">
                                            @GetTransactionTypeLabel(trx.Type)
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Amount">
                                        <MudText
                                            Color="@(trx.Type == VaultTransactionType.ManualDeposit || trx.Type == VaultTransactionType.SurplusDeposit ? Color.Success : Color.Error)">
                                            @(trx.Type == VaultTransactionType.ManualDeposit || trx.Type == VaultTransactionType.SurplusDeposit ? "+" :
                                                                                "-")UGX @trx.Amount.ToString("N0")
                                        </MudText>
                                    </MudTd>
                                    <MudTd DataLabel="Notes">@trx.Notes</MudTd>
                                    <MudTd DataLabel="Expires In">
                                        @if (trx.ExpiresAt.HasValue)
                                        {
                                            var timeRemaining = trx.ExpiresAt.Value - DateTimeOffset.UtcNow;
                                            if (timeRemaining.TotalMinutes > 0)
                                            {
                                                <MudText Typo="Typo.caption">
                                                    @if (timeRemaining.TotalHours >= 1)
                                                    {
                                                        @($"{(int)timeRemaining.TotalHours}h {timeRemaining.Minutes}m")
                                                    }
                                                    else
                                                    {
                                                        @($"{timeRemaining.Minutes}m")
                                                    }
                                                </MudText>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Expired</MudChip>
                                            }
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                            OnClick="@(() => DecideTransactionAsync(trx, true))"
                                            Disabled="@(_actioning || _decisionUncertain || _historyLoading || (trx.ExpiresAt.HasValue && trx.ExpiresAt.Value <= DateTimeOffset.UtcNow))">
                                            Approve
                                        </MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                            Disabled="@(_actioning || _decisionUncertain || _historyLoading)"
                                            OnClick="@(() => DecideTransactionAsync(trx, false))">
                                            Reject
                                        </MudButton>
                                    </MudTd>
                                </RowTemplate>
                                <PagerContent><MudTablePager PageSizeOptions="@PageSizes" /></PagerContent>
                            </MudTable>
                        </MudCardContent>
                    </MudCard>
                }
            </Authorized>
        </AuthorizeView>

        <!-- Transaction History -->
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" HtmlTag="h2">Transaction History</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">All recorded history, including expired requests. Dates are shown in Uganda time.</MudText>
                <MudGrid Class="mb-3">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="VaultTransactionStatus?" Label="Transaction status" @bind-Value="_status" @bind-Value:after="ApplyFiltersAsync" Clearable="true" Disabled="_actioning">
                            @foreach (var status in Enum.GetValues<VaultTransactionStatus>())
                            {
                                <MudSelectItem T="VaultTransactionStatus?" Value="@((VaultTransactionStatus?)status)">@GetStatusLabel(status)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="VaultTransactionType?" Label="Transaction type" @bind-Value="_type" @bind-Value:after="ApplyFiltersAsync" Clearable="true" Disabled="_actioning">
                            @foreach (var type in Enum.GetValues<VaultTransactionType>())
                            {
                                <MudSelectItem T="VaultTransactionType?" Value="@((VaultTransactionType?)type)">@GetTransactionTypeLabel(type)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                @if (_historyError != null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@_historyError</MudAlert>
                }
                    <MudTable T="VaultTransactionListItemDto" @ref="_history" ServerData="LoadHistoryAsync" RowsPerPage="10"
                        Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm" Loading="_historyLoading" data-testid="vault-history">
                        <HeaderContent>
                            <MudTh>Date (Uganda)</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Amount</MudTh>
                            <MudTh>Balance After</MudTh>
                            <MudTh>Created By</MudTh>
                            <MudTh>Approved By</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="trx">
                            <MudTd DataLabel="Date (Uganda)">@BusinessTimeText.Format(trx.CreatedAt)</MudTd>
                            <MudTd DataLabel="Type">
                                <MudChip T="string" Color="@GetTransactionTypeColor(trx.Type)"
                                    Icon="@GetTransactionTypeIcon(trx.Type)" Size="Size.Small">
                                    @GetTransactionTypeLabel(trx.Type)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Color="@GetStatusColor(trx.Status)" Size="Size.Small">
                                    @GetStatusLabel(trx.Status)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Amount">
                                <MudText
                                    Color="@(trx.Type == VaultTransactionType.ManualDeposit || trx.Type == VaultTransactionType.Closing || trx.Type == VaultTransactionType.SurplusDeposit ? Color.Success : Color.Error)">
                                    @(trx.Type == VaultTransactionType.ManualDeposit || trx.Type == VaultTransactionType.Closing || trx.Type == VaultTransactionType.SurplusDeposit
                                                                ? "+" : "-")UGX @trx.Amount.ToString("N0")
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Balance After">
                                @if (trx.BalanceAfter.HasValue)
                                {
                                    <MudText Color="Color.Primary" Typo="Typo.body2">UGX @trx.BalanceAfter.Value.ToString("N0")
                                    </MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Created By">@trx.CreatedBy</MudTd>
                            <MudTd DataLabel="Approved By">@(trx.ApprovedBy ?? "-")</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Class="pa-4">@(_historyError != null ? "History is unavailable. Select Refresh to retry." :
                                _status.HasValue || _type.HasValue ? "No transactions match these filters. Clear the filters to see all history." : "No vault transactions yet.")</MudText>
                        </NoRecordsContent>
                        <PagerContent><MudTablePager PageSizeOptions="@PageSizes" /></PagerContent>
                    </MudTable>
            </MudCardContent>
        </MudCard>
    }
    else
    {
        <MudAlert Severity="Severity.Error">Unable to load vault information.</MudAlert>
    }
</MudContainer>

@code {
    private VaultDto? _vault;
    private MudTable<VaultTransactionListItemDto>? _history;
    private List<VaultTransactionListItemDto> _pendingTransactions = [];
    private bool _isLoading = true;
    private long _branchId = 1;
    private bool _canApprove;
    private bool _historyLoading;
    private bool _actioning;
    private bool _decisionUncertain;
    private string? _error;
    private string? _historyError;
    private VaultTransactionStatus? _status;
    private VaultTransactionType? _type;
    private readonly SemaphoreSlim _queryLock = new(1, 1);
    private static readonly int[] PageSizes = [10, 25, 50];

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated != true)
            {
                Snackbar.Add("User is not authenticated.", Severity.Error);
                return;
            }

            // Get branch ID from claims
            var branchIdClaim = user.FindFirst("BranchId");
            if (!long.TryParse(branchIdClaim?.Value, out var branchId))
            {
                Snackbar.Add("User is not associated with a branch. Please contact an administrator.", Severity.Error);
                _vault = null;
                _isLoading = false;
                return;
            }

            _branchId = branchId;
            _canApprove = user.IsInRole(UserRole.Admin.ToString());
            await LoadVaultAsync();
        }
        catch (Exception ex)
        {
            // Handle error
            Console.WriteLine($"Error during vault initialization: {ex.Message}");
            Snackbar.Add($"Error initializing vault page: {ex.Message}", Severity.Error);
            _isLoading = false;
        }
    }

    private async Task LoadVaultAsync()
    {
        await _queryLock.WaitAsync();
        _isLoading = true;
        _error = null;
        try
        {
            _vault = await VaultService.GetVaultAsync(_branchId);
            if (_vault == null)
            {
                Snackbar.Add($"No vault found for branch {_branchId}. Please ensure the branch is properly configured.",
                Severity.Warning);
                _vault = null;
            }
            else
            {
                _pendingTransactions = _canApprove ? await VaultService.GetPendingTransactionsAsync(_branchId) : [];
                _decisionUncertain = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError("Vault loading failed with {ExceptionType}.", ex.GetType().Name);
            _error = "Vault information could not be refreshed. Select Refresh to retry; previously loaded information may be out of date.";
        }
        finally
        {
            _isLoading = false;
            _queryLock.Release();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        if (_history == null) return;
        if (_history.CurrentPage == 0) await _history.ReloadServerData();
        else _history.NavigateTo(0);
    }

    private async Task<TableData<VaultTransactionListItemDto>> LoadHistoryAsync(TableState state, CancellationToken token)
    {
        await _queryLock.WaitAsync(token);
        _historyLoading = true;
        _historyError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await VaultService.GetHistoryPageAsync(_branchId, new(state.Page, state.PageSize), _status, _type, token);
            return new() { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
        catch (Exception exception)
        {
            Logger.LogError("Vault history failed with {ExceptionType}.", exception.GetType().Name);
            _historyError = "Vault history could not be loaded. Select Refresh to retry.";
            return new() { Items = [], TotalItems = 0 };
        }
        finally
        {
            _historyLoading = false;
            _queryLock.Release();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NavigateToAdjustment()
    {
        NavigationManager.NavigateTo("/vault-adjustment");
    }

    private async Task DecideTransactionAsync(VaultTransactionListItemDto transaction, bool approve)
    {
        if (_actioning || _decisionUncertain || _historyLoading) return;
        _actioning = true;
        try
        {
            var verb = approve ? "Approve" : "Reject";
            if (await DialogService.ShowMessageBox($"{verb} vault request",
                $"{GetTransactionTypeLabel(transaction.Type)} of UGX {transaction.Amount:N0}, requested by {transaction.CreatedBy}. Notes: {transaction.Notes}",
                yesText: $"{verb} request", cancelText: "Cancel") != true) return;
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? throw new UnauthorizedAccessException();
            await _queryLock.WaitAsync();
            VaultOperationResult result;
            try
            {
                result = approve ? await VaultService.ApproveManualAdjustmentAsync(transaction.Id, userId)
                    : await VaultService.RejectManualAdjustmentAsync(transaction.Id, userId);
            }
            finally { _queryLock.Release(); }
            if (!result.Success)
                _error = result.ErrorMessage ?? "The request could not be updated.";
            else
            {
                Snackbar.Add(approve ? "Request approved." : "Request rejected.", Severity.Success);
                await LoadVaultAsync();
            }
        }
        catch (Exception exception)
        {
            Logger.LogError("Vault decision failed with {ExceptionType}.", exception.GetType().Name);
            _decisionUncertain = true;
            _error = "The decision could not be confirmed. Refresh the vault status before trying again.";
        }
        finally { _actioning = false; }
    }

    private Color GetTransactionTypeColor(VaultTransactionType type) => type switch
    {
        VaultTransactionType.Opening => Color.Warning,
        VaultTransactionType.Closing => Color.Info,
        VaultTransactionType.ManualDeposit => Color.Success,
        VaultTransactionType.ManualWithdrawal => Color.Error,
        VaultTransactionType.SurplusDeposit => Color.Info,
        _ => Color.Default
    };

    private string GetTransactionTypeIcon(VaultTransactionType type) => type switch
    {
        VaultTransactionType.Opening => Icons.Material.Filled.Input,
        VaultTransactionType.Closing => Icons.Material.Filled.Output,
        VaultTransactionType.ManualDeposit => Icons.Material.Filled.AddCircle,
        VaultTransactionType.ManualWithdrawal => Icons.Material.Filled.RemoveCircle,
        VaultTransactionType.SurplusDeposit => Icons.Material.Filled.TrendingUp,
        _ => Icons.Material.Filled.Help
    };

    private string GetTransactionTypeLabel(VaultTransactionType type) => type switch
    {
        VaultTransactionType.Opening => "Opening",
        VaultTransactionType.Closing => "Closing",
        VaultTransactionType.ManualDeposit => "Deposit",
        VaultTransactionType.ManualWithdrawal => "Withdrawal",
        VaultTransactionType.SurplusDeposit => "Surplus",
        _ => "Unknown"
    };

    private Color GetStatusColor(VaultTransactionStatus status) => status switch
    {
        VaultTransactionStatus.Completed => Color.Success,
        VaultTransactionStatus.Pending => Color.Warning,
        VaultTransactionStatus.Rejected => Color.Error,
        VaultTransactionStatus.Expired => Color.Error,
        _ => Color.Default
    };

    private string GetStatusLabel(VaultTransactionStatus status) => status switch
    {
        VaultTransactionStatus.Completed => "Completed",
        VaultTransactionStatus.Pending => "Pending",
        VaultTransactionStatus.Rejected => "Rejected",
        VaultTransactionStatus.Expired => "Expired",
        _ => "Unknown"
    };
}