@page "/bank-statements"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using EastSeat.Agenti.Shared.Services
@using EastSeat.Agenti.Web.Features.BankStatements
@inherits BankingPageBase
@attribute [Authorize(Policy = "BankReconciliation")]
@rendermode InteractiveServer
@inject IBankAccountService Accounts
@inject IDailyBankStatementService Statements
@inject IBusinessClock Clock
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<BankEvidenceOptions> EvidenceOptions

<PageTitle>Daily bank statements - Agenti</PageTitle>
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Daily bank statements</MudText>
    <MudText>Upload one complete statement for each Bank wallet for one selected date. Cash and Mobile Money need no statement.</MudText>
    <MudButton Href="/cashcount-approvals">Closing approvals</MudButton>
    <MudButton Href="/bank-accounts">Manage bank accounts</MudButton>
    <MudButton OnClick="ReloadAsync" Disabled="Busy">Refresh</MudButton>
    <MudButton Href="/templates/agenti-bank-statement-v1.csv" Download="agenti-bank-statement-v1.csv">Download CSV template</MudButton>
    @if (Error != null)
    {
        <MudAlert Severity="Severity.Error" Class="my-3">@Error</MudAlert>
    }
    @if (_accepted != null)
    {
        <MudAlert Severity="Severity.Success" Class="my-3">@_accepted</MudAlert>
    }
    @if (Loaded && _accounts.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">Register a Bank wallet's account on <MudLink Href="/bank-accounts">Bank accounts</MudLink> before uploading statements.</MudAlert>
    }
    @if (_selected is { } selected)
    {
    <MudText>@selected.BankName / @selected.Currency / @selected.BalanceBasis</MudText>
    <MudText Typo="Typo.body2">Bank wallet: @selected.WalletName</MudText>
    <MudText Typo="Typo.body2">Agent: @selected.AgentLabel</MudText>
    <MudLink Href="@($"/bank-accounts?accountId={selected.Id}")">Manage account</MudLink>
    <MudPaper Class="pa-4 my-4" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2">Upload for the selected account and date</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">Check the agent, wallet and business date before choosing a file. Accepted revisions are retained; used statements are locked.</MudText>
        <MudSelect T="long" Label="Bank account" Value="_accountId" ValueChanged="ChangeAccountAsync" Disabled="Busy">
            @foreach (var account in _accounts)
            {
                <MudSelectItem T="long" Value="@account.Id">@account.BankName - @account.AccountIdentifier - @account.WalletName - @account.AgentLabel</MudSelectItem>
            }
        </MudSelect>
        <MudDatePicker Label="Statement date" Date="_date" DateChanged="ChangeDateAsync"
                       Editable="true" DateFormat="yyyy-MM-dd" Disabled="Busy" />
        <MudText Typo="Typo.body2" Class="my-2">Every TransactionDate must equal the selected date. Multi-day and empty statements are rejected.</MudText>
        <InputFile @key="_fileKey" OnChange="SelectFile" aria-label="Complete single-day CSV statement" accept=".csv" disabled="@Busy" />
        @if (_file != null)
        {
            <MudText>@_file.Name</MudText>
        }
        <MudCheckBox T="bool" @bind-Value="_confirmed" Disabled="Busy"
                     Label="I confirm this file belongs to the selected bank account and covers the complete selected day" />
        @if (_imports.Count > 0)
        {
            <MudTextField T="string" Label="Replacement reason" @bind-Value="_reason" Disabled="Busy"
                          HelperText="A different file requires a reason of 10-2,000 characters; the previous version is retained." />
        }
        <MudButton OnClick="UploadAsync" Disabled="@(Busy || _file == null || _accountId == 0 || !_confirmed)"
                   Color="Color.Primary" Variant="Variant.Filled">Upload statement</MudButton>
        <MudButton OnClick="RefreshAsync" Disabled="Busy">Refresh statements</MudButton>
    </MudPaper>
    <MudText Typo="Typo.h6" HtmlTag="h2">Statement history for the selected account and date</MudText>
    <MudTable Items="_imports" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Revision</MudTh><MudTh>File</MudTh><MudTh>Rows</MudTh>
            <MudTh>Debits</MudTh><MudTh>Credits</MudTh><MudTh>Status</MudTh><MudTh>Replacement reason</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Revision">@context.Revision</MudTd><MudTd DataLabel="File"><MudLink Href="@($"/closing-statement-evidence/{context.Id}")">@context.FileName</MudLink></MudTd><MudTd DataLabel="Rows">@context.RowCount</MudTd>
            <MudTd DataLabel="Debits">@context.TotalDebits.ToString("N2")</MudTd><MudTd DataLabel="Credits">@context.TotalCredits.ToString("N2")</MudTd>
            <MudTd DataLabel="Status">@(context.IsUsed ? "Used - locked" : context.Id == _imports[0].Id ? "Ready" : "Superseded")</MudTd>
            <MudTd DataLabel="Replacement reason">@context.ReplacementReason</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No accepted statement for this account and date.</MudText></NoRecordsContent>
    </MudTable>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery] public long? AccountId { get; set; }
    [SupplyParameterFromQuery(Name = "date")] public string? RequestedDate { get; set; }
    private List<BankAccountDto> _accounts = [];
    private List<DailyBankStatementDto> _imports = [];
    private long _accountId;
    private BankAccountDto? _selected;
    private DateTime? _date;
    private IBrowserFile? _file;
    private Guid _fileKey = Guid.NewGuid();
    private bool _confirmed;
    private string? _reason;
    private string? _accepted;
    private (long? AccountId, string? Date)? _loadedQuery;

    protected override Task OnParametersSetAsync()
    {
        var query = (AccountId, RequestedDate);
        if (_loadedQuery == query) return Task.CompletedTask;
        _loadedQuery = query;
        return ReloadAsync();
    }

    private Task ReloadAsync() => RunAsync(async () =>
    {
        ResetSelection();
        _selected = null;
        _imports = [];
        _accounts = await Accounts.GetAccountsAsync(UserId);
        _accountId = AccountId ?? _accounts.FirstOrDefault()?.Id ?? 0;
        if (AccountId.HasValue && !_accounts.Any(a => a.Id == AccountId))
            throw new UnauthorizedAccessException();
        _selected = _accounts.SingleOrDefault(a => a.Id == _accountId);
        _date = (RequestedDate == null ? Clock.Today : ParseDate(RequestedDate)).ToDateTime(TimeOnly.MinValue);
        await LoadImportsAsync();
    }, queueIfBusy: true);

    private Task LoadImportsAsync() => LoadSelectedAsync();

    private async Task LoadSelectedAsync()
    {
        _imports = _accountId == 0 || !_date.HasValue ? [] :
            await Statements.GetAsync(UserId, _accountId, DateOnly.FromDateTime(_date.Value));
    }

    private Task RefreshAsync() => RunAsync(LoadImportsAsync);
    private Task ChangeAccountAsync(long value)
    {
        Navigation.NavigateTo($"/bank-statements?accountId={value}&date={_date:yyyy-MM-dd}");
        return Task.CompletedTask;
    }
    private Task ChangeDateAsync(DateTime? value)
    {
        if (value.HasValue)
        {
            Navigation.NavigateTo($"/bank-statements?accountId={_accountId}&date={value:yyyy-MM-dd}");
            return Task.CompletedTask;
        }
        return RunAsync(() =>
        {
            _date = null;
            ResetSelection();
            _imports = [];
            return Task.CompletedTask;
        });
    }
    private void ResetSelection()
    {
        _confirmed = false;
        _accepted = null;
        _file = null;
        _fileKey = Guid.NewGuid();
        _reason = null;
    }
    private void SelectFile(InputFileChangeEventArgs args)
    {
        _file = args.File;
        _confirmed = false;
        _accepted = null;
    }
    private Task UploadAsync() => RunAsync(async () =>
    {
        if (_file == null || !_date.HasValue)
            throw new BankingRuleException("Select a statement date and CSV file.");
        await using var stream = _file.OpenReadStream(EvidenceOptions.Value.MaxFileBytes);
        var saved = await Statements.UploadAsync(UserId,
            new DailyStatementUpload(_accountId, DateOnly.FromDateTime(_date.Value), _confirmed, _imports.FirstOrDefault()?.Id, _reason),
            _file.Name, stream);
        ResetSelection();
        _accepted = $"Statement accepted for {saved.StatementDate:yyyy-MM-dd}: {saved.RowCount} rows, revision {saved.Revision}.";
        await LoadImportsAsync();
    });
}
