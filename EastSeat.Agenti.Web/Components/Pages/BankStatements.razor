@page "/bank-statements"
@using Microsoft.AspNetCore.Authorization
@using EastSeat.Agenti.Shared.Domain.Enums
@using EastSeat.Agenti.Shared.Services
@using EastSeat.Agenti.Web.Features.BankStatements
@inherits BankingPageBase
@attribute [Authorize(Policy = "BankReconciliation")]
@rendermode InteractiveServer
@inject IBankAccountService Accounts
@inject IBankStatementService Statements
@inject IBankEvidenceService Evidence
@inject IBusinessClock Clock
@inject Microsoft.Extensions.Options.IOptions<BankEvidenceOptions> EvidenceOptions

<PageTitle>Bank Statements - Agenti</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h4">Bank statements</MudText>
        <MudButton Href="/bank-reconciliation">Reconciliation</MudButton>
        <MudButton OnClick="LoadAsync" Disabled="Busy">Refresh</MudButton>
    </MudStack>
    @if (Error != null) { <MudAlert Severity="Severity.Error" Class="my-3">@Error</MudAlert> }
    @if (Busy) { <MudProgressLinear Indeterminate="true" Class="my-3" /> }
    <MudExpansionPanels Class="my-3">
        <MudExpansionPanel Text="Register a bank account">
            @if (_setup != null)
            {
                <MudStack Spacing="2">
                    <MudSelect T="long" Label="Agent bank wallet" @bind-Value="_newAccount.WalletId" Disabled="Busy">
                        @foreach (var wallet in _setup.Wallets)
                        {
                            <MudSelectItem T="long" Value="@wallet.Id">@wallet.AgentName - @wallet.Name (@wallet.Currency)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" Label="Bank name" @bind-Value="_newAccount.BankName" />
                    <MudTextField T="string" Label="Account identifier shown on statement" @bind-Value="_newAccount.AccountIdentifier" />
                    <MudTextField T="string" Label="Statement time zone" @bind-Value="_newAccount.TimeZoneId" />
                    <MudSelect T="BankBalanceBasis" Label="Confirmed balance basis" @bind-Value="_newAccount.BalanceBasis">
                        @foreach (var basis in Enum.GetValues<BankBalanceBasis>()) { <MudSelectItem T="BankBalanceBasis" Value="@basis">@basis</MudSelectItem> }
                    </MudSelect>
                    <MudButton OnClick="CreateAccountAsync" Disabled="Busy" Color="Color.Primary" Variant="Variant.Filled">Save account binding</MudButton>
                </MudStack>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>
    @if (Loaded && Error == null && _accounts.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Register the existing agent bank wallet to begin. This does not move money or change legacy sessions.</MudAlert>
    }
    <MudSelect T="long" Label="Bank account" Value="_accountId" ValueChanged="SelectAccountAsync" Disabled="Busy">
        @foreach (var account in _accounts)
        {
            <MudSelectItem T="long" Value="@account.Id">@account.BankName - @account.AccountIdentifier</MudSelectItem>
        }
    </MudSelect>
    @if (_selected != null)
    {
        <MudPaper Class="pa-4 my-3" Outlined="true">
            <MudText>@_selected.BankName / @_selected.Currency / @_selected.BalanceBasis</MudText>
            <MudText>New-session enrollment: @(_selected.WorkflowEnabled ? "Enabled" : "Paused")</MudText>
            <MudButton OnClick="ToggleWorkflowAsync" Disabled="Busy" Color="Color.Warning">
                @(_selected.WorkflowEnabled ? "Pause new enrollment" : "Enable new-session workflow")
            </MudButton>
            <MudExpansionPanels Class="mt-3">
                <MudExpansionPanel Text="Account configuration">
                    <MudTextField T="string" Label="Bank name" @bind-Value="_editAccount.BankName" />
                    <MudTextField T="string" Label="Account identifier" @bind-Value="_editAccount.AccountIdentifier" />
                    <MudTextField T="string" Label="Statement time zone" @bind-Value="_editAccount.TimeZoneId" />
                    <MudSelect T="BankBalanceBasis" Label="Balance basis" @bind-Value="_editAccount.BalanceBasis">
                        @foreach (var basis in Enum.GetValues<BankBalanceBasis>()) { <MudSelectItem T="BankBalanceBasis" Value="@basis">@basis</MudSelectItem> }
                    </MudSelect>
                    <MudButton OnClick="ConfigureAsync" Disabled="Busy">Save configuration</MudButton>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudPaper>
        <MudPaper Class="pa-4 my-3" Outlined="true">
            <MudText Typo="Typo.h6">Upload a bank statement CSV</MudText>
            <MudText Typo="Typo.body2">Download the <a href="/templates/agenti-bank-statement-v1.csv" download>blank CSV template</a> and <a href="/templates/agenti-bank-statement-v1-guide.txt" target="_blank">column guide</a>. Convert the bank export outside Agenti, then upload one CSV for the selected date range. The app checks daily balances and movements; date-only rows do not certify exact session cutoff balances.</MudText>
            <MudGrid Class="my-2">
                <MudItem xs="12" sm="4"><MudDatePicker Label="Start date" @bind-Date="_fromDate" Editable="true" DateFormat="yyyy-MM-dd" Disabled="Busy" /></MudItem>
                <MudItem xs="12" sm="4"><MudDatePicker Label="End date" @bind-Date="_toDate" Editable="true" DateFormat="yyyy-MM-dd" Disabled="Busy" /></MudItem>
                @if (!_imports.Any(i => i.Status == StatementImportStatus.Committed && i.CoverageVerified))
                {
                    <MudItem xs="12" sm="4"><MudNumericField T="decimal?" Label="Initial opening balance (first empty period only)" @bind-Value="_openingBaseline" Min="0" /></MudItem>
                }
            </MudGrid>
            @if (_openingBaseline.HasValue)
            {
                <MudTextField T="string" Label="Baseline source and reason (audited)" @bind-Value="_openingBaselineReason" Lines="2" />
            }
            <MudText Typo="Typo.caption">Headers must match exactly: TransactionDate, TransactionTime, Reference, Description, Debit, Credit, RunningBalance. Time may be blank; never add a time the bank did not provide.</MudText>
            <InputFile OnChange="SelectFile" accept=".csv" disabled="@Busy" />
            @if (_file != null) { <MudText>@_file.Name</MudText> }
            <MudButton OnClick="UploadAsync" Disabled="@(Busy || _file == null)" Color="Color.Primary" Variant="Variant.Filled" Class="mt-2">Upload and validate</MudButton>
        </MudPaper>
        <MudTable T="BankStatementImportDto" Items="_imports" Dense="true" Hover="true">
            <HeaderContent><MudTh>Source</MudTh><MudTh>Status</MudTh><MudTh>Coverage</MudTh><MudTh>Validation</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd><MudLink Href="@($"/banking-evidence/{context.EvidenceFileId}")" Target="_blank">@context.FileName</MudLink></MudTd>
                <MudTd>@context.Status (revision @context.Revision)</MudTd>
                <MudTd>@(context.CoverageFrom.HasValue ? UgandaTime(context.CoverageFrom.Value) : "-") to @(context.CoverageTo.HasValue ? UgandaTime(context.CoverageTo.Value) : "-")</MudTd>
                <MudTd>@context.ErrorMessage</MudTd>
                <MudTd>
                    <MudButton OnClick="@(() => PreviewAsync(context.Id))" Disabled="Busy">Review</MudButton>
                    <MudButton OnClick="@(() => ReprocessAsync(context))" Disabled="@(Busy || context.Status is StatementImportStatus.Uploaded or StatementImportStatus.Processing)">Reprocess as new revision</MudButton>
                </MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    }
    @if (_preview != null)
    {
        <MudPaper Class="pa-4 my-4" Outlined="true">
            <MudText Typo="Typo.h5">Import #@_preview.Import.Id - @_preview.Import.Status</MudText>
            @foreach (var issue in _preview.Errors) { <MudAlert Severity="Severity.Error" Class="my-2">@issue</MudAlert> }
            @if (_preview.Import.Status is StatementImportStatus.Uploaded or StatementImportStatus.Processing)
            {
                <MudAlert Severity="Severity.Info">Processing is server-side. Refresh this preview to retrieve its durable status.</MudAlert>
            }
            else if (_preview.Import.Status == StatementImportStatus.ReadyForReview && _preview.Rows.Count == 0 && _preview.Errors.Count == 0)
            {
                <MudAlert Severity="Severity.Info">The source declares complete coverage with no transactions. Opening and closing balances must agree.</MudAlert>
            }
            <MudButton OnClick="@(() => PreviewAsync(_preview.Import.Id))" Disabled="Busy">Refresh preview</MudButton>
            <MudTable T="StatementRowDto" Items="_preview.Rows" Dense="true" Class="my-3">
                <HeaderContent><MudTh>Row / time</MudTh><MudTh>Bank identity / narration</MudTh><MudTh>Movement</MudTh><MudTh>Balance</MudTh><MudTh>Identity decision</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>#@context.Id @context.SourceLocation<br />@UgandaTime(context.OccurredAt)</MudTd>
                    <MudTd>@context.TransactionNumber / @context.Reference<br />@context.CustomerIdentifier<br />@context.Narration</MudTd>
                    <MudTd>@context.SignedAmount.ToString("N2")</MudTd><MudTd>@context.RunningBalance.ToString("N2")</MudTd>
                    <MudTd>
                        @if (context.RequiresIdentityDecision && _decisions.TryGetValue(context.Id, out var decision))
                        {
                            <MudText Typo="Typo.caption">Possible existing occurrences: @string.Join(", ", context.PossibleExistingTransactionIds)</MudText>
                            <MudSelect T="StatementRowResolutionKind" @bind-Value="decision.Kind" Label="Decision">
                                @foreach (var kind in Enum.GetValues<StatementRowResolutionKind>()) { <MudSelectItem T="StatementRowResolutionKind" Value="@kind">@kind</MudSelectItem> }
                            </MudSelect>
                            <MudNumericField T="long?" Label="Existing occurrence ID (when linking/revising)" @bind-Value="decision.ExistingId" />
                            <MudTextField T="string" Label="Evidence-based reason" @bind-Value="decision.Reason" />
                        }
                        else { <MudText Typo="Typo.caption">No identity decision required</MudText> }
                    </MudTd>
                    <MudTd><MudButton OnClick="@(() => SelectRow(context))" Disabled="@(_preview.Import.Status != StatementImportStatus.ReadyForReview || Busy)">Correct extraction</MudButton></MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
            <MudButton OnClick="CommitAsync" Disabled="@(Busy || _preview.Import.Status != StatementImportStatus.ReadyForReview || _preview.Errors.Count > 0)" Color="Color.Primary" Variant="Variant.Filled">Commit reviewed bank entries</MudButton>
        </MudPaper>
    }
    @if (_editRowId.HasValue)
    {
        <MudPaper Class="pa-4 my-3" Outlined="true">
            <MudText Typo="Typo.h6">Correct extracted row #@_editRowId</MudText>
            <MudText Typo="Typo.body2">The original source and extraction remain preserved. A correction creates a new normalization revision.</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField T="string" Label="Transaction number" @bind-Value="_rowForm.TransactionNumber" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" Label="Reference" @bind-Value="_rowForm.Reference" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" Label="Customer identifier" @bind-Value="_rowForm.CustomerIdentifier" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" Label="Currency" @bind-Value="_rowForm.Currency" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="decimal" Label="Signed movement (+credit / -debit)" @bind-Value="_rowForm.SignedAmount" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="decimal" Label="Running balance" @bind-Value="_rowForm.RunningBalance" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" Label="Transaction time (Uganda)" @bind-Value="_rowOccurred" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" Label="Posting time (Uganda, optional)" @bind-Value="_rowPosted" /></MudItem>
                <MudItem xs="12"><MudTextField T="string" Label="Narration" @bind-Value="_rowForm.Narration" /></MudItem>
                <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="_rowForm.HasPreciseTimestamp" Label="The bank provides a usable precise timestamp" /></MudItem>
                <MudItem xs="12"><MudTextField T="string" Label="Correction reason" @bind-Value="_rowForm.Reason" Lines="2" /></MudItem>
            </MudGrid>
            <MudButton OnClick="CorrectRowAsync" Disabled="Busy" Color="Color.Primary">Save normalization correction</MudButton>
        </MudPaper>
    }
</MudContainer>

@code {
    private List<BankAccountDto> _accounts = [];
    private BankAccountSetupDto? _setup;
    private long _accountId;
    private BankAccountDto? _selected;
    private BankAccountForm _newAccount = new();
    private BankAccountForm _editAccount = new();
    private List<BankStatementImportDto> _imports = [];
    private BankStatementPreviewDto? _preview;
    private IBrowserFile? _file;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private decimal? _openingBaseline;
    private string? _openingBaselineReason;
    private Guid _uploadKey = Guid.NewGuid();
    private readonly Dictionary<long, RowDecision> _decisions = [];
    private long? _editRowId;
    private CorrectStatementRowForm _rowForm = new();
    private string _rowOccurred = string.Empty;
    private string _rowPosted = string.Empty;
    private sealed class RowDecision
    {
        public StatementRowResolutionKind Kind { get; set; }
        public long? ExistingId { get; set; }
        public string Reason { get; set; } = string.Empty;
    }

    protected override Task OnInitializedAsync()
    {
        _fromDate = _toDate = Clock.Today.ToDateTime(TimeOnly.MinValue);
        return LoadAsync();
    }

    private Task LoadAsync() => RunAsync(async () =>
    {
        _accounts = await Accounts.GetAccountsAsync(UserId);
        _setup = await Accounts.GetSetupAsync(UserId);
        if (_accountId == 0) _accountId = _accounts.FirstOrDefault()?.Id ?? 0;
        await LoadSelectedAsync();
    });

    private async Task LoadSelectedAsync()
    {
        _selected = _accounts.SingleOrDefault(a => a.Id == _accountId);
        if (_selected == null) return;
        _editAccount = new BankAccountForm
        {
            WalletId = _selected.WalletId, BankName = _selected.BankName, AccountIdentifier = _selected.AccountIdentifier,
            TimeZoneId = _selected.TimeZoneId, BalanceBasis = _selected.BalanceBasis, ImportProfileKey = _selected.ImportProfileKey
        };
        _imports = await Statements.GetImportsAsync(UserId, _accountId);
    }

    private Task SelectAccountAsync(long id) => RunAsync(async () => { _accountId = id; _preview = null; await LoadSelectedAsync(); });
    private async Task CreateAccountAsync()
    {
        if (await RunAsync(async () => { _accountId = (await Accounts.CreateAsync(UserId, _newAccount)).Id; _newAccount = new(); }))
            await LoadAsync();
    }
    private async Task ConfigureAsync()
    {
        if (await RunAsync(async () => { await Accounts.ConfigureAsync(UserId, _accountId, _editAccount, _selected!.Version); }))
            await LoadAsync();
    }
    private async Task ToggleWorkflowAsync()
    {
        if (await RunAsync(async () => { await Accounts.SetWorkflowAsync(UserId, _accountId, !_selected!.WorkflowEnabled, _selected.Version); }))
            await LoadAsync();
    }
    private void SelectFile(InputFileChangeEventArgs args) { _file = args.File; _uploadKey = Guid.NewGuid(); }
    private Task UploadAsync() => RunAsync(async () =>
    {
        if (_file == null || _accountId == 0 || !_fromDate.HasValue || !_toDate.HasValue)
            throw new BankingRuleException("Select an account, date range and CSV file.");
        await using var stream = _file.OpenReadStream(EvidenceOptions.Value.MaxFileBytes);
        var file = await Evidence.UploadAsync(UserId, _accountId, _uploadKey, _file.Name, true, stream);
        var import = await Statements.StartAsync(UserId, _accountId, file.Id,
            new StatementImportRequest(DateOnly.FromDateTime(_fromDate.Value), DateOnly.FromDateTime(_toDate.Value),
                _openingBaseline, _openingBaselineReason));
        _imports = await Statements.GetImportsAsync(UserId, _accountId);
        SetPreview(await Statements.GetPreviewAsync(UserId, import.Id));
    });
    private Task PreviewAsync(long id) => RunAsync(async () => SetPreview(await Statements.GetPreviewAsync(UserId, id)));
    private Task ReprocessAsync(BankStatementImportDto import) => RunAsync(async () =>
    {
        var revision = await Statements.StartAsync(UserId, import.BankAccountId, import.EvidenceFileId, true);
        _imports = await Statements.GetImportsAsync(UserId, _accountId);
        SetPreview(await Statements.GetPreviewAsync(UserId, revision.Id));
    });
    private void SetPreview(BankStatementPreviewDto preview)
    {
        var sameVersion = _preview?.Import.Id == preview.Import.Id && _preview.Import.Version == preview.Import.Version;
        _preview = preview;
        if (sameVersion) return;
        _decisions.Clear();
        foreach (var row in preview.Rows.Where(r => r.RequiresIdentityDecision))
            _decisions[row.Id] = new RowDecision
            {
                Kind = row.PossibleExistingTransactionIds.Count == 1 ? StatementRowResolutionKind.LinkExisting : StatementRowResolutionKind.NewOccurrence,
                ExistingId = row.PossibleExistingTransactionIds.Count == 1 ? row.PossibleExistingTransactionIds[0] : null
            };
    }
    private Task CommitAsync() => RunAsync(async () =>
    {
        await Statements.CommitAsync(UserId, _preview!.Import.Id, new CommitStatementForm
        {
            ExpectedVersion = _preview.Import.Version,
            Resolutions = _decisions.Select(d => new StatementRowResolution(d.Key, d.Value.Kind, d.Value.ExistingId, d.Value.Reason)).ToList()
        });
        SetPreview(await Statements.GetPreviewAsync(UserId, _preview.Import.Id));
        _imports = await Statements.GetImportsAsync(UserId, _accountId);
    });
    private void SelectRow(StatementRowDto row)
    {
        _editRowId = row.Id;
        _rowForm = new CorrectStatementRowForm
        {
            ExpectedVersion = _preview!.Import.Version, TransactionNumber = row.TransactionNumber, Reference = row.Reference,
            CustomerIdentifier = row.CustomerIdentifier, Narration = row.Narration, Currency = row.Currency,
            SignedAmount = row.SignedAmount, RunningBalance = row.RunningBalance, ValueDate = row.ValueDate,
            HasPreciseTimestamp = row.HasPreciseTimestamp
        };
        _rowOccurred = UgandaTime(row.OccurredAt);
        _rowPosted = row.PostedAt.HasValue ? UgandaTime(row.PostedAt.Value) : string.Empty;
    }
    private Task CorrectRowAsync() => RunAsync(async () =>
    {
        _rowForm.OccurredAt = ParseUgandaTime(_rowOccurred);
        _rowForm.PostedAt = string.IsNullOrWhiteSpace(_rowPosted) ? null : ParseUgandaTime(_rowPosted);
        SetPreview(await Statements.CorrectRowAsync(UserId, _preview!.Import.Id, _editRowId!.Value, _rowForm));
        _editRowId = null;
    });
}
