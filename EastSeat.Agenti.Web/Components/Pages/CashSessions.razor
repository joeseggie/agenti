@page "/cashsessions"
@using Microsoft.AspNetCore.Authorization
@using EastSeat.Agenti.Web.Features.CashSessions
@using EastSeat.Agenti.Shared.Domain.Enums
@using EastSeat.Agenti.Shared.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICashSessionService CashSessionService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<CashSessions> Logger

<PageTitle>Cash Sessions - Agenti</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Cash Sessions</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Branch-level daily cash sessions with agent participation
            </MudText>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadSessionsAsync"
                StartIcon="@Icons.Material.Filled.Refresh" Disabled="_isLoading">
                Refresh
            </MudButton>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="4">
            <MudSelect T="CashSessionStatus?" Label="Session status" @bind-Value="_status" @bind-Value:after="ApplyFiltersAsync" Clearable="true" Disabled="_isLoading">
                @foreach (var status in Enum.GetValues<CashSessionStatus>())
                {
                    <MudSelectItem T="CashSessionStatus?" Value="@((CashSessionStatus?)status)">@GetStatusText(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="From business date" @bind-Date="_from" @bind-Date:after="ApplyFiltersAsync" Editable="true" DateFormat="yyyy-MM-dd" Clearable="true" Disabled="_isLoading" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="To business date" @bind-Date="_to" @bind-Date:after="ApplyFiltersAsync" Editable="true" DateFormat="yyyy-MM-dd" Clearable="true" Disabled="_isLoading" />
        </MudItem>
    </MudGrid>
    <MudButton OnClick="ClearFiltersAsync" Disabled="_isLoading" Class="mt-2">Clear filters</MudButton>
    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }
        <MudTable T="CashSessionListItemDto" @ref="_table" ServerData="LoadPageAsync" RowsPerPage="10"
            Hover="true" Striped="true" Dense="true" Elevation="2" Class="mt-4"
            Breakpoint="Breakpoint.Sm" Loading="_isLoading" data-testid="session-history">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh Style="text-align: center;">Status</MudTh>
                <MudTh Style="text-align: center;">Agents</MudTh>
                <MudTh Style="text-align: right;">Opening (UGX)</MudTh>
                <MudTh Style="text-align: right;">Closing (UGX)</MudTh>
                <MudTh Style="text-align: center;">Pending</MudTh>
                <MudTh Style="text-align: center;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">
                    <MudText Typo="Typo.body2">@context.SessionDate.ToString("ddd, MMM dd, yyyy")</MudText>
                </MudTd>
                <MudTd DataLabel="Status" Style="text-align: center;">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                        @GetStatusText(context.Status)
                    </MudChip>
                    <MudText Typo="Typo.caption">@context.WorkflowDisplay</MudText>
                </MudTd>
                <MudTd DataLabel="Agents" Style="text-align: center;">
                    <MudText Typo="Typo.body2">
                        @context.ApprovedClosingCount / @context.AgentCount
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Opening" Style="text-align: right;">
                    <MudText Typo="Typo.body2">@context.TotalOpeningAmount.ToString("N0")</MudText>
                </MudTd>
                <MudTd DataLabel="Closing" Style="text-align: right;">
                    @if (context.TotalClosingAmount.HasValue)
                    {
                        <MudText Typo="Typo.body2">@context.TotalClosingAmount.Value.ToString("N0")</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default" Style="opacity: 0.5;">---</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Pending" Style="text-align: center;">
                    @if (context.PendingApprovalCount > 0)
                    {
                        <MudBadge Content="@context.PendingApprovalCount" Color="Color.Warning" Overlap="true">
                            <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" />
                        </MudBadge>
                    }
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align: center;">
                    <MudTooltip Text="View Details">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small"
                            aria-label="@($"View session for {context.SessionDate:yyyy-MM-dd}")"
                            OnClick="@(() => ViewSession(context.Id))" />
                    </MudTooltip>
                    <AuthorizeView Roles="Admin,Supervisor">
                        <Authorized Context="authCtx">
                            @if (context.WorkflowVersion == SessionWorkflowVersion.Legacy && context.Status == CashSessionStatus.Open && context.AllClosingCountsApproved)
                            {
                                <MudTooltip Text="Close Session">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small"
                                        aria-label="@($"Close session for {context.SessionDate:yyyy-MM-dd}")"
                                        Disabled="_isLoading" OnClick="@(() => ConfirmCloseSession(context))" />
                                </MudTooltip>
                            }
                        </Authorized>
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">@(_error != null ? "Session history is unavailable. Correct the filters or select Refresh to retry." :
                    _status.HasValue || _from.HasValue || _to.HasValue ? "No sessions match these filters. Clear the filters to see all sessions." :
                    "No cash sessions yet. Sessions are created when an opening count is performed.")</MudText>
            </NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="@PageSizes" /></PagerContent>
        </MudTable>
</MudContainer>

@code {
    private MudTable<CashSessionListItemDto>? _table;
    private bool _isLoading;
    private bool _closing;
    private string? _error;
    private CashSessionStatus? _status;
    private DateTime? _from;
    private DateTime? _to;
    private readonly SemaphoreSlim _queryLock = new(1, 1);
    private static readonly int[] PageSizes = [10, 25, 50];

    private async Task ApplyFiltersAsync()
    {
        if (_table == null) return;
        if (_table.CurrentPage == 0) await _table.ReloadServerData();
        else _table.NavigateTo(0);
    }

    private Task LoadSessionsAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;
    private Task ClearFiltersAsync()
    {
        _status = null;
        _from = null;
        _to = null;
        return ApplyFiltersAsync();
    }

    private async Task<TableData<CashSessionListItemDto>> LoadPageAsync(TableState state, CancellationToken token)
    {
        await _queryLock.WaitAsync(token);
        _isLoading = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await CashSessionService.GetCashSessionsPageAsync(new(state.Page, state.PageSize),
                status: _status, from: _from.HasValue ? DateOnly.FromDateTime(_from.Value) : null,
                to: _to.HasValue ? DateOnly.FromDateTime(_to.Value) : null, cancellationToken: token);
            return new() { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
            return new() { Items = [], TotalItems = 0 };
        }
        catch (Exception exception)
        {
            Logger.LogError("Session history failed with {ExceptionType}.", exception.GetType().Name);
            _error = "Session history could not be loaded. Select Refresh to retry.";
            return new() { Items = [], TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
            _queryLock.Release();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ViewSession(long sessionId)
    {
        NavigationManager.NavigateTo($"/cashsessions/{sessionId}");
    }

    private async Task ConfirmCloseSession(CashSessionListItemDto session)
    {
        if (_closing || _isLoading) return;
        _closing = true;
        try
        {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Title, "Close Cash Session" },
            { x => x.MarkupMessage, new MarkupString($"Are you sure you want to close the session for <b>{session.SessionDate:MMM dd, yyyy}</b>?<br/><br/>All agents' closing counts must be approved. This action cannot be undone.") },
            { x => x.YesText, "Close Session" },
            { x => x.NoText, "Cancel" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<MudMessageBox>("Close Session", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CloseSessionAsync(session.Id);
        }
        }
        catch (Exception exception)
        {
            Logger.LogError("Session closure failed with {ExceptionType}.", exception.GetType().Name);
            _error = "The closure could not be confirmed. Refresh the session status before trying again.";
        }
        finally { _closing = false; }
    }

    private async Task CloseSessionAsync(long sessionId)
    {
        await _queryLock.WaitAsync();
        (bool success, string? errorMessage) result;
        try { result = await CashSessionService.CloseSessionAsync(sessionId); }
        finally { _queryLock.Release(); }

        if (result.success)
        {
            Snackbar.Add("Cash session closed successfully.", Severity.Success);
            await LoadSessionsAsync();
        }
        else
        {
            Snackbar.Add(result.errorMessage ?? "Failed to close session.", Severity.Error);
        }
    }

    private static Color GetStatusColor(CashSessionStatus status) => status switch
    {
        CashSessionStatus.Open => Color.Success,
        CashSessionStatus.Completed => Color.Info,
        CashSessionStatus.Pending => Color.Warning,
        CashSessionStatus.DiscrepancyUnderReview => Color.Warning,
        CashSessionStatus.Blocked => Color.Error,
        CashSessionStatus.Closed => Color.Default,
        _ => Color.Default
    };

    private static string GetStatusText(CashSessionStatus status) => status switch
    {
        CashSessionStatus.Open => "Open",
        CashSessionStatus.Completed => "Completed",
        CashSessionStatus.Pending => "Pending",
        CashSessionStatus.DiscrepancyUnderReview => "Under Review",
        CashSessionStatus.Blocked => "Blocked",
        CashSessionStatus.Closed => "Closed",
        _ => "Unknown"
    };
}
