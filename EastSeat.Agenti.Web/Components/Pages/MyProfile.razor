@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using EastSeat.Agenti.Web.Features.Users
@attribute [Authorize]
@inject IUserService UserService
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar

<PageTitle>My Profile</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">My Profile</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_user is null)
    {
        <MudAlert Severity="Severity.Error">Unable to load profile.</MudAlert>
    }
    else
    {
        <MudCard Class="mb-4">
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">First Name</MudText>
                        <MudText Typo="Typo.body1">@_user.FirstName</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Last Name</MudText>
                        <MudText Typo="Typo.body1">@_user.LastName</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText>
                        <MudText Typo="Typo.body1">@_user.Email</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Phone</MudText>
                        <MudText Typo="Typo.body1">@(_user.PhoneNumber ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Role</MudText>
                        <MudText Typo="Typo.body1">@_user.Role</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_user.IsActive ? Color.Success : Color.Error)">
                            @(_user.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Change Password</MudText>
            </MudCardHeader>
            <MudCardContent>
                <EditForm Model="_changePasswordModel" OnValidSubmit="ChangePasswordAsync">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_changePasswordModel.CurrentPassword"
                                          Label="Current Password"
                                          InputType="InputType.Password"
                                          Variant="Variant.Outlined"
                                          Required="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_changePasswordModel.NewPassword"
                                          Label="New Password"
                                          InputType="InputType.Password"
                                          Variant="Variant.Outlined"
                                          Required="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_confirmPassword"
                                          Label="Confirm New Password"
                                          InputType="InputType.Password"
                                          Variant="Variant.Outlined"
                                          Required="true" />
                        </MudItem>
                        @if (!string.IsNullOrEmpty(_changePasswordError))
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Error" Dense="true">@_changePasswordError</MudAlert>
                            </MudItem>
                        }
                    </MudGrid>
                    <MudCardActions>
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="_savingPassword">
                            @if (_savingPassword)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Change Password
                        </MudButton>
                    </MudCardActions>
                </EditForm>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    private UserDetailDto? _user;
    private bool _loading = true;
    private string? _userId;

    private ChangePasswordModel _changePasswordModel = new();
    private string _confirmPassword = string.Empty;
    private string? _changePasswordError;
    private bool _savingPassword;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await Auth.GetAuthenticationStateAsync();
            _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (!string.IsNullOrEmpty(_userId))
            {
                _user = await UserService.GetByIdAsync(_userId);
                _changePasswordModel.UserId = _userId;
            }
        }
        catch
        {
            // Leave _user as null so the "Unable to load profile." message is shown.
            _user = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _changePasswordError = null;

        if (string.IsNullOrWhiteSpace(_changePasswordModel.NewPassword))
        {
            _changePasswordError = "New password is required.";
            return;
        }

        if (_changePasswordModel.NewPassword != _confirmPassword)
        {
            _changePasswordError = "New password and confirmation do not match.";
            return;
        }

        _savingPassword = true;
        try
        {
            var result = await UserService.ChangePasswordAsync(_changePasswordModel);
            if (result.Success)
            {
                Snackbar.Add("Password changed successfully.", Severity.Success);
                _changePasswordModel = new ChangePasswordModel { UserId = _userId ?? string.Empty };
                _confirmPassword = string.Empty;
            }
            else
            {
                _changePasswordError = result.Message ?? "Failed to change password.";
            }
        }
        finally
        {
            _savingPassword = false;
        }
    }
}
