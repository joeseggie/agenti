<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android-only for Play Store deployment -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>EastSeat.Agenti.Android</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name shown to users on device -->
		<ApplicationTitle>Agenti</ApplicationTitle>

		<!-- Play Store app identifier - must match your Play Console app ID -->
		<ApplicationId>com.eastseat.agenti</ApplicationId>

		<!-- App version for Play Store (increment for each release) -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!--
			Minimum Android version: API 24 (Android 7.0 Nougat, released 2016)
			Covers ~97%+ of active Android devices as of 2024.
			Users on Android 5.0-6.x (API 21-23) will not be able to install the app.
		-->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Raw\appsettings.json" LogicalName="appsettings.json" />
		<EmbeddedResource Include="Resources\Raw\appsettings.Development.json" LogicalName="appsettings.Development.json" Condition="'$(Configuration)' == 'Debug' and Exists('Resources\Raw\appsettings.Development.json')" />
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(Configuration)' == 'Debug' and '$(BankingTestApiUrl)' != ''">
			<_Parameter1>Agenti.BankingTestApiUrl</_Parameter1>
			<_Parameter2>$(BankingTestApiUrl)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1976D2" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1976D2" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Pages\ProfilePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\EastSeat.Agenti.Web\Shared\Domain\Enums\ReconciliationEnums.cs" Link="Models\Banking\ReconciliationEnums.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Shared\Domain\Enums\CashCountStatus.cs" Link="Models\Banking\CashCountStatus.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Shared\Domain\Enums\CashCountAuditAction.cs" Link="Models\Banking\CashCountAuditAction.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Shared\Domain\Enums\WalletAdjustmentReason.cs" Link="Models\Banking\WalletAdjustmentReason.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Shared\Domain\Enums\WalletAdjustmentStatus.cs" Link="Models\Banking\WalletAdjustmentStatus.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Features\CustomerTransactions\CustomerTransactionDtos.cs" Link="Models\Banking\CustomerTransactionDtos.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Features\BankStatements\BankEvidenceDtos.cs" Link="Models\Banking\BankEvidenceDtos.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Features\BankReconciliation\BankReconciliationDtos.cs" Link="Models\Banking\BankReconciliationDtos.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Features\BankReconciliation\BankingRequests.cs" Link="Models\Banking\BankingRequests.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Features\BankRuns\BankRunDtos.cs" Link="Models\Banking\BankRunDtos.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Features\WalletAdjustments\WalletAdjustmentDtos.cs" Link="Models\Banking\WalletAdjustmentDtos.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Features\CashCounts\CashCountDtos.cs" Link="Models\Banking\CashCountDtos.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Features\CashCounts\DenominationBreakdown.cs" Link="Models\Banking\DenominationBreakdown.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Shared\Services\BusinessTimeText.cs" Link="Models\Banking\BusinessTimeText.cs" />
		<Compile Include="..\EastSeat.Agenti.Web\Shared\Services\BankingRuleException.cs" Link="Models\Banking\BankingRuleException.cs" />
	</ItemGroup>

</Project>
