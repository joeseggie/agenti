<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EastSeat.Agenti.Android.Pages.ProfilePage"
             Title="User Profile"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="32,64,32,32" Spacing="0">
            <Label Text="User Profile"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#1976D2"
                   HorizontalOptions="Center"
                   Margin="0,0,0,32" />

            <Label Text="Name"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                   Margin="0,0,0,6" />
            <Label x:Name="NameLabel" Text="Loading..." FontSize="16" Margin="0,0,0,16" />

            <Label Text="Email Address"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                   Margin="0,0,0,6" />
            <Label x:Name="EmailLabel" Text="Loading..." FontSize="16" Margin="0,0,0,16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
