<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EastSeat.Agenti.Android.Models"
             x:Class="EastSeat.Agenti.Android.Pages.DashboardPage"
             Title="Dashboard">

    <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Loading indicator -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   Color="#1976D2"
                                   IsRunning="False"
                                   IsVisible="False" />

                <!-- Error message -->
                <Label x:Name="ErrorLabel"
                       TextColor="#D32F2F"
                       FontSize="14"
                       IsVisible="False"
                       Margin="0,8" />

                <!-- Welcome card -->
                <Border StrokeThickness="0"
                        BackgroundColor="#1976D2"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <VerticalStackLayout>
                        <Label x:Name="WelcomeLabel"
                               Text="Welcome"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold" />
                        <Label x:Name="SessionStatusLabel"
                               Text="No Active Session"
                               TextColor="#BBDEFB"
                               FontSize="14"
                               Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Vault balance card -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <VerticalStackLayout>
                        <Label Text="Vault Balance"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}" />
                        <Label x:Name="TotalBalanceLabel"
                               Text="UGX 0"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}"
                               Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Vault vs agents summary -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            StrokeShape="RoundRectangle 8"
                            Padding="12">
                        <VerticalStackLayout>
                            <Label Text="Agent Wallets"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}" />
                            <Label x:Name="TotalAgentBalanceLabel"
                                   Text="UGX 0"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                            StrokeShape="RoundRectangle 8"
                            Padding="12">
                        <VerticalStackLayout>
                            <Label Text="Difference"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}" />
                            <Label x:Name="DifferenceLabel"
                                   Text="UGX 0"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Agent summary section -->
                <Label Text="Agent Wallet Balances"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />

                <CollectionView x:Name="AgentSummariesCollectionView"
                                ItemsSource="{Binding AgentSummaries}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No agent balances found."
                               TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"
                               FontSize="14"
                               HorizontalOptions="Center"
                               Margin="0,16" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AgentWalletSummary">
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="16"
                                    Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding AgentName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F5F5}" />
                                        <Label Text="{Binding AgentCode}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding TotalBalance, StringFormat='{0:N0}'}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#1976D2"
                                               HorizontalOptions="End" />
                                        <Label Text="{Binding Currency}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
