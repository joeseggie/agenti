      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "RELEASE GATE: E8 (enable) is impossible until a verified statement profile for this bank is installed (E1-E3).\nThe inspected code registers none. E4-E6 can be prepared now; uploads stay private evidence. One active teller and one enrolled account per branch.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "banner",
      "originalText": "RELEASE GATE: E8 (enable) is impossible until a verified statement profile for this bank is installed (E1-E3).\nThe inspected code registers none. E4-E6 can be prepared now; uploads stay private evidence. One active teller and one enrolled account per branch.",
      "autoResize": false,
      "lineHeight": 2.5
    },
